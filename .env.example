# Copy this file to .env and edit. NEVER commit .env or share real keys.
# Comments are on their own lines on purpose: an empty value followed by an inline
# comment would be parsed as the comment text.

# ======================= Mode =======================
# demo = no API keys, no database. Local hashing embedder + extractive "LLM" + in-memory
#        store with sample docs auto-loaded. Great for trying the UI; not real AI quality.
# live = real PostgreSQL/Supabase + real embedding model + real LLM.
APP_MODE=demo

# ================= Database (live mode) =================
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the "Session pooler" string if your network is IPv4-only (common on Windows/home ISPs).
# Replace [YOUR-PASSWORD]; URL-encode special characters in the password.
DATABASE_URL=

# ================= Embeddings (live mode) =================
# openai | demo
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match vector(N) in supabase/migrations/001_*.sql and 003_*.sql
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works here
OPENAI_BASE_URL=https://api.openai.com/v1

# ================= LLM (live mode) =================
# openai | anthropic | demo
LLM_PROVIDER=openai
# e.g. gpt-4o-mini for openai, or a Claude model name such as claude-sonnet-5 for anthropic
LLM_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# ================= Retrieval =================
TOP_K=5
USE_HYBRID=true
USE_RERANK=true
# Abstain when the best retrieved chunk has cosine similarity below this value.
# Tune on your own eval set; real embedding models usually want 0.25-0.35.
MIN_SIMILARITY=0.20
# Reject LLM answers that contain no valid [n] citation
REQUIRE_CITATIONS=true

# ================= Chunking =================
CHUNK_MAX_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# ================= Ingestion =================
# Optional: raises the GitHub API limit from 60 to 5000 requests/hour
GITHUB_TOKEN=
# Demo mode only: load data/sample_docs and data/sample_issues at startup
DEMO_AUTO_INGEST=true

# ================= Security (optional) =================
# If set, every endpoint except /health requires the header  X-API-Key: <value>
API_KEY=
# false: POST /ingest with source=local may only read folders inside ./data
ALLOW_ANY_LOCAL_PATH=false

# ================= Frontend =================
API_BASE_URL=http://127.0.0.1:8000
